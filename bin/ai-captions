#!/usr/bin/env bash
# ai-captions IN.mp4 [OUT.mp4] [--srt existing.srt] [--model small] -> burns big bold captions (auto-transcribed)
set -euo pipefail
[ $# -ge 1 ] || { echo "usage: ai-captions IN.mp4 [OUT.mp4] [--srt file.srt] [--model small]"; exit 1; }
IN="$1"; shift; OUT="${IN%.*}_captioned.mp4"; [[ $# -ge 1 && "$1" != --* ]] && { OUT="$1"; shift; }
SRT=""; MODEL=small
while [ $# -gt 0 ]; do case "$1" in --srt) SRT="$2"; shift;; --model) MODEL="$2"; shift;; esac; shift; done
if [ -z "$SRT" ]; then BASE="${IN%.*}"; ai-lyrics "$IN" --model "$MODEL" --out "$BASE" >/dev/null; SRT="$BASE.srt"; fi
TMP="$(dirname "$(realpath -m "$OUT")")/.aicap_$$.srt"; cp "$SRT" "$TMP"
nice -n 10 ffmpeg -v error -y -i "$IN" -vf "subtitles=$TMP:force_style='FontName=DejaVu Sans,Bold=1,FontSize=16,PrimaryColour=&H00FFFFFF,OutlineColour=&H00000000,BorderStyle=1,Outline=2,Shadow=0,Alignment=2,MarginV=60'" -c:v libx264 -preset veryfast -crf 21 -c:a copy "$OUT"
rm -f "$TMP"; echo "$OUT (captions: $SRT)"
